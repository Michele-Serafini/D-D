{
  "name": "mercante-errante",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs src/utils/*.test.ts",
    "test:party": "node --test tests/party-management.test.mjs",
    "test:browsers": "playwright test",
    "format": "prettier --write \"{js,css,scripts,config,tests,src}/**/*.{js,mjs,ts,css,json}\" \"*.{html,ts,json}\"",
    "format:check": "prettier --check \"{js,css,scripts,config,tests,src}/**/*.{js,mjs,ts,css,json}\" \"*.{html,ts,json}\"",
    "rules:build": "node scripts/build-database-rules.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prebuild": "npm run check:secrets",
    "test:rules": "npx --yes firebase-tools@15.34.1 emulators:exec --only database --project demo-dd-campaigns \"node --test tests/rules/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.14.0",
    "firebase": "^13.1.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.15",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
